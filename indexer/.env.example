# ── Indexer Service ──────────────────────────────────────
PORT=3002

# ── Stellar Network ───────────────────────────────────────
HORIZON_URL=https://horizon-testnet.stellar.org
STELLAR_NETWORK=testnet

# ── Contract Addresses ────────────────────────────────────
FACTORY_CONTRACT_ADDRESS=CAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAABSC4

# ── Database ──────────────────────────────────────────────
# SQLite database path (for indexer local storage)
DB_PATH=./data/indexer.db

# ── Polling Resilience ─────────────────────────────────────
# Exponential backoff for retrying failed RPC polls (all optional, shown with defaults)
POLLER_MIN_BACKOFF_MS=1000
POLLER_MAX_BACKOFF_MS=300000
POLLER_BACKOFF_MULTIPLIER=2

# Poller batch size (default: 50, max: 500). Automatically scales to 500 when lag > 1000 ledgers
INDEXER_BATCH_SIZE=50

