{
  "name": "bankerchanger-backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "ts-node-dev --respawn src/index.ts",
    "build": "tsc --noEmit",
    "build:prod": "tsc",
    "lint": "eslint 'src/**/*.ts' 'tests/**/*.ts'",
    "format": "prettier --write 'src/**/*.ts' 'tests/**/*.ts'",
    "precommit": "node scripts/verify-schema.js",
    "migrate": "drizzle-kit migrate",
    "migrate:down": "node-pg-migrate down",
    "migrate:create": "node-pg-migrate create",
    "migrate:generate": "drizzle-kit generate:pg",
    "migrate:check": "node scripts/migration-check.js",
    "migrate:dry-run": "node scripts/migration-check.js --dry-run",
    "drizzle:check": "drizzle-kit check:pg",
    "drizzle:pull": "drizzle-kit introspect:pg",
    "drizzle:studio": "drizzle-kit studio",
    "schema:verify": "node scripts/verify-schema.js",
    "openapi:validate": "node scripts/validate-openapi.js",
    "openapi:postman": "node scripts/generate-postman.js",
    "test": "jest --passWithNoTests",
    "test:integration": "jest --passWithNoTests --testPathPatterns=tests/integration",
    "test:e2e": "jest --passWithNoTests --runInBand --testPathPatterns=tests/e2e"
  },
  "dependencies": {
    "@sentry/node": "10.68.0",
    "@types/bcrypt": "^6.0.0",
    "@types/nodemailer": "^8.0.0",
    "bad-words": "^3.0.4",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "drizzle-kit": "^0.31.10",
    "drizzle-orm": "^0.45.2",
    "express": "^4.19.2",
    "ioredis": "^5.10.1",
    "jsonwebtoken": "^9.0.3",
    "node-cron": "^4.6.0",
    "nodemailer": "^8.0.6",
    "otpauth": "^9.5.1",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.0",
    "winston": "^3.13.0",
    "ws": "^8.21.2",
    "yaml": "^2.4.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@apidevtools/swagger-parser": "^12.1.0",
    "@stellar/stellar-sdk": "^15.0.1",
    "@types/bad-words": "^3.0.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/node-cron": "^3.0.11",
    "@types/pg": "^8.20.4",
    "@types/pino-http": "^5.8.4",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0",
    "eslint": "^8.57.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "jest-mock": "^29.7.0",
    "jest-util": "^29.7.0",
    "node-pg-migrate": "^8.0.4",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
